ame=&quot;ScriptModule&quot; type=&quot;System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35&quot;/&amp;gt;&#xA;            &amp;lt;add name=&quot;ErrorLog&quot; type=&quot;Elmah.ErrorLogModule, Elmah&quot;/&amp;gt;&#xA;        &amp;lt;/httpModules&amp;gt;&#xA;    &amp;lt;/system.web&amp;gt;&#xA;&#xA;&amp;lt;/configuration&amp;gt;&#xA;&lt;/code&gt;&lt;/pre&gt;&#xA;" OwnerUserId="1284" OwnerDisplayName="Mark Struzinski" LastActivityDate="2012-05-11T14:11:15.100" Title="Send email from Elmah?" Tags="&lt;.net&gt;&lt;asp.net&gt;&lt;elmah&gt;" AnswerCount="3" CommentCount="0" FavoriteCount="32" ContentLicense="CC BY-SA 2.5" />
